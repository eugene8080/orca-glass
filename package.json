{
  "name": "orca-glass",
  "version": "1.0.1",
  "private": true,
  "description": "Control Orca agent sessions from Even Realities G2 glasses",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "pair": "node scripts/pair.mjs",
    "doctor": "node scripts/doctor.mjs",
    "sim:check": "pwsh -NoProfile -File scripts/start-simulator.ps1",
    "beta:pack": "node scripts/build-beta.mjs",
    "beta:update": "node scripts/update-beta.mjs",
    "test": "node --test tests/*.test.mjs",
    "pair:native": "node scripts/pair-native.mjs"
  }
}
